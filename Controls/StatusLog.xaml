<UserControl x:Class="ddeprivedd.os.Controls.StatusLog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="14" Background="{StaticResource InsetBrush}" Padding="6">
        <Grid>
            <TextBlock x:Name="EmptyText" Text="Nothing yet. Run an action and live activity shows up here."
                       Foreground="{StaticResource MutedBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="Scroller" Style="{StaticResource SmoothScroll}">
                <StackPanel x:Name="Rows" Margin="10"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
