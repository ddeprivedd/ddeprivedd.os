<Window x:Class="ddeprivedd.os.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ddeprivedd.os"
        Width="1180" Height="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Border x:Name="Shell" CornerRadius="22" Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Soft background glows -->
            <Canvas Grid.ColumnSpan="2" IsHitTestVisible="False">
                <Ellipse Canvas.Left="540" Canvas.Top="-250" Width="600" Height="600">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#338B5CF6" Offset="0"/>
                            <GradientStop Color="#008B5CF6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Canvas.Left="220" Canvas.Top="470" Width="560" Height="560">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2238BDF8" Offset="0"/>
                            <GradientStop Color="#0038BDF8" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" CornerRadius="21,0,0,21"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="20,24,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,34">
                        <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ddeprivedd.os" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="PC optimizer" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation -->
                    <Grid Grid.Row="1">
                        <Border x:Name="NavPill" Height="50" VerticalAlignment="Top" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#448B5CF6" Offset="0"/>
                                    <GradientStop Color="#1138BDF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PillShift" Y="0"/>
                            </Border.RenderTransform>
                            <Border Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradient}"/>
                        </Border>

                        <StackPanel>
                            <RadioButton x:Name="NavOptimizer" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE945;" Content="Optimizer" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavWhitelist" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE72E;" Content="Whitelist" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavCleaner" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE74D;" Content="Cleaner" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavMonitor" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE9D9;" Content="Monitor" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavRamLimiter" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE950;" Content="RAM Limiter" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Ready" FontSize="12" Margin="10,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="VersionText" Text="v3.0" FontSize="12" Margin="12,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drag area + window buttons -->
            <Border Grid.ColumnSpan="2" Height="56" VerticalAlignment="Top" Background="Transparent"
                    MouseLeftButtonDown="DragBar_MouseDown"/>

            <!-- Page host (animated when switching tabs) -->
            <ContentControl x:Name="Host" Grid.Column="1" Margin="0,56,0,0" IsTabStop="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="HostShift" Y="0"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,12,16,0">
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                        Height="32" Padding="14,0" FontSize="12" Margin="0,0,12,0"
                        Background="{StaticResource AccentBrush}" Click="UpdateButton_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" Width="40" Height="32"
                        Click="Minimize_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Width="40" Height="32"
                        Foreground="{StaticResource TextBrush}" Margin="4,0,0,0"
                        Tag="{StaticResource HoverRedBrush}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
