<UserControl x:Class="ddeprivedd.os.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ddeprivedd.os.Controls">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="TempGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8B5CF6" Offset="0"/>
            <GradientStop Color="#FFC084FC" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BinGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF10B981" Offset="0"/>
            <GradientStop Color="#FF34D399" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TempGlow" Color="#FF8B5CF6"/>
        <SolidColorBrush x:Key="BinGlow" Color="#FF10B981"/>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource SmoothScroll}">
        <StackPanel x:Name="PageRoot" Margin="36,8,36,36">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="System Cleaner"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Deep clean junk files and keep Windows tidy."/>
            </StackPanel>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource GameCard}" Tag="{StaticResource TempGlow}"
                                Margin="0,0,10,0">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Left"
                                Background="{StaticResource TempGrad}">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Temp files" Style="{StaticResource CardTitle}" FontSize="22" Margin="0,18,0,0"/>
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,8,0,0" MinHeight="40"
                                   Text="Delete leftover files from your temporary folder."/>
                        <Button x:Name="TempBtn" Style="{StaticResource PrimaryButton}" Content="CLEAN TEMP FILES"
                                Background="{StaticResource TempGrad}" Margin="0,20,0,0" Click="TempClean_Click"/>
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Column="1" Style="{StaticResource GameCard}" Tag="{StaticResource BinGlow}"
                                Margin="10,0,0,0">
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="16" HorizontalAlignment="Left"
                                Background="{StaticResource BinGrad}">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Recycle bin" Style="{StaticResource CardTitle}" FontSize="22" Margin="0,18,0,0"/>
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,8,0,0" MinHeight="40"
                                   Text="Empty the recycle bin and free up disk space."/>
                        <Button x:Name="BinBtn" Style="{StaticResource PrimaryButton}" Content="EMPTY RECYCLE BIN"
                                Background="{StaticResource BinGrad}" Margin="0,20,0,0" Click="RecycleClean_Click"/>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <ContentControl Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Cleaner status"/>
                        <TextBlock x:Name="PercentText" Text="0%" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="Bar" Style="{StaticResource GlowProgress}" Margin="0,16,0,16" Value="0"/>
                    <ctl:StatusLog x:Name="Log" Height="260"/>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
