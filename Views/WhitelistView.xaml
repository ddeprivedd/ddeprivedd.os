<UserControl x:Class="ddeprivedd.os.Views.WhitelistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Style="{StaticResource SmoothScroll}">
        <StackPanel x:Name="PageRoot" Margin="36,8,36,36">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="App Whitelist"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Apps on this list are never force-closed by the optimizer."/>
            </StackPanel>

            <!-- Add an app -->
            <ContentControl Style="{StaticResource Card}" Margin="0,28,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Add an app"/>
                    <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,16"
                               Text="Type the process name shown in Task Manager, like chrome or obs64. Adding .exe is optional."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" Style="{StaticResource InputBox}"
                                 Tag="Process name, for example chrome" KeyDown="NameBox_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add to whitelist"
                                Background="{StaticResource AccentGradient}" Margin="12,0,0,0"
                                Click="Add_Click"/>
                    </Grid>
                    <TextBlock x:Name="Hint" Margin="4,10,0,0" FontSize="12.5" Opacity="0"
                               Foreground="{StaticResource MutedBrush}" MinHeight="16"/>
                </StackPanel>
            </ContentControl>

            <!-- Running apps -->
            <ContentControl Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Open right now" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshBtn" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                HorizontalAlignment="Right" Click="Refresh_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,0"
                               Text="Pick an app that is open and press Protect."/>
                    <ScrollViewer Style="{StaticResource SmoothScroll}" Height="300" Margin="0,14,0,0">
                        <StackPanel x:Name="RunningList"/>
                    </ScrollViewer>
                </StackPanel>
            </ContentControl>

            <!-- Protected apps -->
            <ContentControl Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource CardTitle}" Text="Protected apps"/>
                        <Border CornerRadius="10" Background="#338B5CF6" Padding="10,2" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" Text="0" FontWeight="Bold" FontSize="12.5"
                                       Foreground="{StaticResource AccentSoftBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,14"
                               Text="The optimizer will leave these running."/>
                    <StackPanel x:Name="ProtectedList"/>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
