<UserControl x:Class="ddeprivedd.os.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Style="{StaticResource SmoothScroll}">
        <StackPanel x:Name="PageRoot" Margin="36,8,36,36">

            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Live Monitor"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Real-time CPU, memory and process activity, refreshed every second."/>
            </StackPanel>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <ContentControl Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#338B5CF6">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="#FFA78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CPU USAGE" FontSize="12" FontWeight="Bold" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="CpuText" Text="0%" FontSize="44" FontWeight="Bold" Margin="0,16,0,0"/>
                        <Canvas x:Name="CpuCanvas" Height="56" Margin="0,8,0,0" ClipToBounds="True">
                            <Polygon x:Name="CpuArea" Fill="#2A8B5CF6"/>
                            <Polyline x:Name="CpuLine" Stroke="#FF8B5CF6" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Canvas>
                    </StackPanel>
                </ContentControl>

                <!-- RAM -->
                <ContentControl Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,5,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#3334D399">
                                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="RAM USAGE" FontSize="12" FontWeight="Bold" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="RamText" Text="0 GB" FontSize="44" FontWeight="Bold" Margin="0,16,0,0"/>
                        <Canvas x:Name="RamCanvas" Height="56" Margin="0,8,0,0" ClipToBounds="True">
                            <Polygon x:Name="RamArea" Fill="#2A34D399"/>
                            <Polyline x:Name="RamLine" Stroke="#FF34D399" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Canvas>
                    </StackPanel>
                </ContentControl>

                <!-- Processes -->
                <ContentControl Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#3338BDF8">
                                <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PROCESSES" FontSize="12" FontWeight="Bold" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="ProcessText" Text="0" FontSize="44" FontWeight="Bold" Margin="0,16,0,0"/>
                        <Canvas x:Name="ProcCanvas" Height="56" Margin="0,8,0,0" ClipToBounds="True">
                            <Polygon x:Name="ProcArea" Fill="#2A38BDF8"/>
                            <Polyline x:Name="ProcLine" Stroke="#FF38BDF8" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Canvas>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- Memory detail -->
            <ContentControl Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Memory in use"/>
                        <TextBlock x:Name="MemDetail" Text="--" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentSoftBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="MemBar" Style="{StaticResource GlowProgress}" Margin="0,16,0,0" Value="0"/>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
